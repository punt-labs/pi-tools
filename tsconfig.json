{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": [
		"extensions/**/*.ts",
		"lib/**/*.ts",
		"tests/**/*.ts",
		"vitest.config.ts",
		"eslint.config.mjs"
	]
}
